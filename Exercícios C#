j) using System;

class Program
{
    public static void Main(string[] args)
    {
        string senha = "1234";
        int tentativas = 0;
        bool acertou = false;

        while (tentativas < 3 && !acertou)
        {
            Console.Write("Digite a senha: ");
            string digitada = Console.ReadLine();
            tentativas++;

            if (digitada == senha)
                acertou = true;
            else
                Console.WriteLine("Senha incorreta! Tentativa " + tentativas + " de 3.");
        }

        if (acertou)
            Console.WriteLine("Senha correta! Acesso liberado.");
        else
            Console.WriteLine("Senha incorreta! Acesso bloqueado.");

        Console.Write("Pressione qualquer tecla para continuar . . . ");
        Console.ReadKey(true);
    }
}

